{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trieramphitheater",
  "main": "worker-entry.js",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
